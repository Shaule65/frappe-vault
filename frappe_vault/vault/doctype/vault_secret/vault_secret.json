{
 "actions": [],
 "allow_rename": 1,
 "autoname": "format:VS-{####}",
 "creation": "2026-05-13 10:00:00",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "basic_info_section",
  "title",
  "secret_type",
  "folder",
  "column_break_basic",
  "url",
  "email",
  "is_bookmark",
  "credentials_section",
  "username",
  "password",
  "totp_secret",
  "column_break_creds",
  "api_key",
  "api_secret",
  "ssh_key_section",
  "ssh_private_key",
  "media_section",
  "attachment",
  "credit_card_section",
  "card_holder",
  "card_number",
  "column_break_card",
  "card_expiry",
  "card_cvv",
  "database_section",
  "database_type",
  "db_host",
  "db_port",
  "column_break_db",
  "db_name",
  "db_auth_source",
  "db_use_ssl",
  "db_password",
  "additional_section",
  "notes",
  "custom_fields_json",
  "expiry_section",
  "expires_on",
  "rotation_section",
  "enable_rotation",
  "rotation_interval",
  "rotation_unit",
  "column_break_rotation2",
  "zip_passphrase",
  "has_zip_passphrase",
  "target_apply_section",
  "apply_rotation_to_target",
  "rotation_admin_username",
  "column_break_target",
  "rotation_admin_password",
  "last_target_apply_status",
  "last_target_apply_on",
  "last_target_apply_error",
  "password_history_section",
  "password_history",
  "metadata_section",
  "password_strength",
  "password_last_changed",
  "last_rotated_on",
  "next_rotation_on",
  "column_break_meta",
  "last_accessed",
  "access_count"
 ],
 "fields": [
  {
   "fieldname": "basic_info_section",
   "fieldtype": "Section Break",
   "label": "Basic Information"
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Title",
   "reqd": 1
  },
  {
   "default": "Password",
   "fieldname": "secret_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Secret Type",
   "options": "Password\nAPI Key\nNote\nSSH Key\nMedia\nCredit Card\nDatabase\nOther",
   "reqd": 1
  },
  {
   "fieldname": "folder",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Folder",
   "options": "Vault Folder"
  },
  {
   "fieldname": "column_break_basic",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "url",
   "fieldtype": "Data",
   "label": "URL"
  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "label": "Email",
   "options": "Email"
  },
  {
   "default": "0",
   "fieldname": "is_bookmark",
   "fieldtype": "Check",
   "label": "Bookmark"
  },
  {
   "depends_on": "eval:['Password', 'SSH Key', 'Database', 'API Key'].includes(doc.secret_type)",
   "fieldname": "credentials_section",
   "fieldtype": "Section Break",
   "label": "Credentials"
  },
  {
   "depends_on": "eval:['Password', 'SSH Key', 'Database'].includes(doc.secret_type)",
   "fieldname": "username",
   "fieldtype": "Data",
   "label": "Username"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Password'",
   "fieldname": "password",
   "fieldtype": "Password",
   "label": "Password"
  },
  {
   "depends_on": "eval:['Password', 'API Key'].includes(doc.secret_type)",
   "fieldname": "totp_secret",
   "fieldtype": "Password",
   "label": "TOTP Secret (2FA Seed)"
  },
  {
   "fieldname": "column_break_creds",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.secret_type === 'API Key'",
   "fieldname": "api_key",
   "fieldtype": "Data",
   "label": "API Key"
  },
  {
   "depends_on": "eval:doc.secret_type === 'API Key'",
   "fieldname": "api_secret",
   "fieldtype": "Password",
   "label": "API Secret"
  },
  {
   "depends_on": "eval:doc.secret_type === 'SSH Key'",
   "fieldname": "ssh_key_section",
   "fieldtype": "Section Break",
   "label": "SSH Key"
  },
  {
   "depends_on": "eval:doc.secret_type === 'SSH Key'",
   "fieldname": "ssh_private_key",
   "fieldtype": "Code",
   "label": "SSH Private Key",
   "options": "Markdown"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Media'",
   "fieldname": "media_section",
   "fieldtype": "Section Break",
   "label": "Document / Media"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Media'",
   "fieldname": "attachment",
   "fieldtype": "Attach",
   "label": "Document / Attachment"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Credit Card'",
   "fieldname": "credit_card_section",
   "fieldtype": "Section Break",
   "label": "Credit Card"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Credit Card'",
   "fieldname": "card_holder",
   "fieldtype": "Data",
   "label": "Card Holder Name"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Credit Card'",
   "fieldname": "card_number",
   "fieldtype": "Password",
   "label": "Card Number"
  },
  {
   "fieldname": "column_break_card",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Credit Card'",
   "fieldname": "card_expiry",
   "fieldtype": "Data",
   "label": "Expiry (MM/YY)"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Credit Card'",
   "fieldname": "card_cvv",
   "fieldtype": "Password",
   "label": "CVV"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "fieldname": "database_section",
   "fieldtype": "Section Break",
   "label": "Database"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "description": "Which engine this credential belongs to. Required to apply a rotated password to the live server.",
   "fieldname": "database_type",
   "fieldtype": "Select",
   "label": "Database Type",
   "mandatory_depends_on": "eval:doc.secret_type === 'Database'",
   "options": "\nPostgreSQL\nMySQL / MariaDB\nMongoDB"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "fieldname": "db_host",
   "fieldtype": "Data",
   "label": "Host"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "fieldname": "db_port",
   "fieldtype": "Int",
   "label": "Port",
   "description": "Leave blank to use the default port for the selected database type."
  },
  {
   "fieldname": "column_break_db",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "fieldname": "db_name",
   "fieldtype": "Data",
   "label": "Database Name"
  },
  {
   "default": "admin",
   "depends_on": "eval:doc.secret_type === 'Database' && doc.database_type === 'MongoDB'",
   "description": "MongoDB database holding this user's credentials. Usually 'admin'.",
   "fieldname": "db_auth_source",
   "fieldtype": "Data",
   "label": "Auth Source"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.secret_type === 'Database'",
   "description": "Connect over TLS. Required by most managed/cloud database providers.",
   "fieldname": "db_use_ssl",
   "fieldtype": "Check",
   "label": "Use TLS / SSL"
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database'",
   "fieldname": "db_password",
   "fieldtype": "Password",
   "label": "Database Password"
  },
  {
   "fieldname": "additional_section",
   "fieldtype": "Section Break",
   "label": "Additional Information"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text Editor",
   "label": "Notes"
  },
  {
   "fieldname": "custom_fields_json",
   "fieldtype": "JSON",
   "hidden": 1,
   "label": "Custom Fields"
  },
  {
   "fieldname": "expiry_section",
   "fieldtype": "Section Break",
   "label": "Expiry"
  },
  {
   "fieldname": "expires_on",
   "fieldtype": "Date",
   "label": "Expires On"
  },
  {
   "depends_on": "eval:['Password', 'Database'].includes(doc.secret_type)",
   "fieldname": "rotation_section",
   "fieldtype": "Section Break",
   "label": "Rotation"
  },
  {
   "default": "0",
   "description": "Generate a new password on a schedule and email it to everyone with access as an encrypted archive. For Database secrets you can additionally have the new password applied to the live server; otherwise this updates the stored value only and you must apply it yourself.",
   "fieldname": "enable_rotation",
   "fieldtype": "Check",
   "label": "Enable Automatic Rotation"
  },
  {
   "default": "90",
   "depends_on": "eval:doc.enable_rotation",
   "fieldname": "rotation_interval",
   "fieldtype": "Int",
   "label": "Rotate Every",
   "mandatory_depends_on": "eval:doc.enable_rotation"
  },
  {
   "default": "Days",
   "depends_on": "eval:doc.enable_rotation",
   "fieldname": "rotation_unit",
   "fieldtype": "Select",
   "label": "Interval Unit",
   "mandatory_depends_on": "eval:doc.enable_rotation",
   "options": "Days\nHours"
  },
  {
   "fieldname": "column_break_rotation2",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.enable_rotation",
   "description": "Protects this secret's rotation archive with a passphrase of your own instead of the shared site one. Stored encrypted, the same way as this secret's own password — recoverable by anyone with Administrator or direct server access, same as any other stored value here. Used automatically by the hourly rotation job to build this secret's archive. Leave blank to use the shared site passphrase.",
   "fieldname": "zip_passphrase",
   "fieldtype": "Password",
   "label": "Custom Rotation Passphrase"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_rotation",
   "fieldname": "has_zip_passphrase",
   "fieldtype": "Check",
   "label": "Passphrase Protection Active",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.secret_type === 'Database' && doc.enable_rotation",
   "fieldname": "target_apply_section",
   "fieldtype": "Section Break",
   "label": "Apply to Live Database"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.secret_type === 'Database' && doc.enable_rotation",
   "description": "Connect to the database on every rotation and change the password there too, so the vault and the server stay in sync. The rotation is aborted and the stored value left untouched if the server cannot be updated.",
   "fieldname": "apply_rotation_to_target",
   "fieldtype": "Check",
   "label": "Apply New Password to the Database"
  },
  {
   "depends_on": "eval:doc.apply_rotation_to_target",
   "description": "Optional privileged account used to run the password change. Leave blank to have the user above change its own password.",
   "fieldname": "rotation_admin_username",
   "fieldtype": "Data",
   "label": "Rotation Admin Username"
  },
  {
   "fieldname": "column_break_target",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.apply_rotation_to_target && doc.rotation_admin_username",
   "description": "Stored encrypted, the same way as this secret's own password. Never rotated by this app.",
   "fieldname": "rotation_admin_password",
   "fieldtype": "Password",
   "label": "Rotation Admin Password",
   "mandatory_depends_on": "eval:doc.apply_rotation_to_target && doc.rotation_admin_username"
  },
  {
   "depends_on": "eval:doc.apply_rotation_to_target",
   "fieldname": "last_target_apply_status",
   "fieldtype": "Select",
   "label": "Last Applied to Database",
   "options": "\nSuccess\nFailed",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.apply_rotation_to_target",
   "fieldname": "last_target_apply_on",
   "fieldtype": "Datetime",
   "label": "Last Applied On",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.last_target_apply_status === 'Failed'",
   "fieldname": "last_target_apply_error",
   "fieldtype": "Small Text",
   "label": "Last Apply Error",
   "read_only": 1
  },
  {
   "collapsible": 1,
   "fieldname": "password_history_section",
   "fieldtype": "Section Break",
   "label": "Password History"
  },
  {
   "description": "One-way hashes of previous passwords. Used to enforce the reuse policy — past values cannot be recovered.",
   "fieldname": "password_history",
   "fieldtype": "Table",
   "label": "Password History",
   "options": "Vault Password History",
   "read_only": 1
  },
  {
   "collapsible": 1,
   "fieldname": "metadata_section",
   "fieldtype": "Section Break",
   "label": "Metadata"
  },
  {
   "fieldname": "password_strength",
   "fieldtype": "Select",
   "label": "Password Strength",
   "options": "\nweak\nfair\ngood\nstrong\nexcellent",
   "read_only": 1
  },
  {
   "fieldname": "password_last_changed",
   "fieldtype": "Date",
   "in_list_view": 1,
   "label": "Password Last Changed",
   "read_only": 1
  },
  {
   "fieldname": "last_rotated_on",
   "fieldtype": "Datetime",
   "label": "Last Rotated On",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.enable_rotation",
   "fieldname": "next_rotation_on",
   "fieldtype": "Datetime",
   "label": "Next Rotation On",
   "read_only": 1
  },
  {
   "fieldname": "column_break_meta",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_accessed",
   "fieldtype": "Datetime",
   "label": "Last Accessed",
   "read_only": 1
  },
  {
   "default": "0",
   "fieldname": "access_count",
   "fieldtype": "Int",
   "label": "Access Count",
   "read_only": 1
  }
 ],
 "links": [
